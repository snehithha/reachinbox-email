generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailJob {
  id              String   @id @default(cuid())

  recipient       String

  subject         String

  body            String

  sender          String

  scheduledAt     DateTime

  sentAt          DateTime?

  status          String

  bullJobId       String?

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt
}
